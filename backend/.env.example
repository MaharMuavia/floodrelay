# --- Model provider ---------------------------------------------------------
# bedrock | anthropic | ollama. Switching provider is this line plus the model
# ids below; nothing else in the codebase constructs a model.
MODEL_PROVIDER=ollama

# Bedrock (Nova has no country gate; Anthropic models on Bedrock do)
AWS_REGION=us-east-1
BEDROCK_MODEL_HEAVY=us.amazon.nova-pro-v1:0
BEDROCK_MODEL_LIGHT=us.amazon.nova-lite-v1:0

# Direct Anthropic API (fallback path)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_HEAVY=claude-opus-4-5
ANTHROPIC_MODEL_LIGHT=claude-haiku-4-5-20251001

# Ollama. Note the port: the desktop app's own server may be misconfigured, so
# this build runs a correctly-configured server on 11435. See the README.
OLLAMA_HOST=http://127.0.0.1:11435
OLLAMA_MODEL_HEAVY=phi3:mini
OLLAMA_MODEL_LIGHT=phi3:mini

# --- Storage ----------------------------------------------------------------
DDB_TABLE=floodrelay
# "memory" (default) for the in-process store, http://localhost:8000 for
# DynamoDB Local, or unset in AWS.
DDB_ENDPOINT=memory
S3_BUCKET=floodrelay-media
S3_ENDPOINT=
MEDIA_DIR=

# --- Outbound services ------------------------------------------------------
# Nominatim REJECTS placeholder contacts: a User-Agent containing "example.org"
# returns HTTP 403. Put a real contact you control here.
NOMINATIM_USER_AGENT=FloodRelay/0.1
NOMINATIM_BASE=https://nominatim.openstreetmap.org
OVERPASS_BASE=https://overpass-api.de/api/interpreter
OPEN_METEO_BASE=https://api.open-meteo.com/v1
RELIEFWEB_BASE=https://api.reliefweb.int/v1

# Bias geocoding to the district being coordinated: west,north,east,south.
# Villages share names across districts; a wrong district is a wrong dispatch.
GEOCODE_VIEWBOX=71.65,34.15,72.30,33.85

# --- Telemetry --------------------------------------------------------------
# Unset disables tracing entirely. Jaeger locally, CloudWatch in AWS.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=floodrelay-agent

# --- Behaviour --------------------------------------------------------------
DEMO_MODE=true
CORS_ORIGINS=http://localhost:3000

# Shared secret for POST /internal/rescan, which the scheduler calls. Unset
# means the route is unauthenticated -- fine locally, not fine when deployed.
INTERNAL_TOKEN=

# Gate thresholds, named here so the rules are auditable in one place.
GEO_CONFIDENCE_FLOOR=0.55
DEDUPE_AUTO_THRESHOLD=0.75
DEDUPE_ASK_FLOOR=0.40
DEDUPE_RADIUS_M=1500
DEDUPE_WINDOW_HOURS=6
