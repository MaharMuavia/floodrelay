# --- Model provider ---------------------------------------------------------
# bedrock | anthropic | ollama. Switching provider is this line plus the model
# ids below; nothing else in the codebase constructs a model.
#
# This choice decides more than which weights answer. With `bedrock` or
# `anthropic` the nodes hand the model the @tool functions and let it choose --
# it calls the geocoder, the rainfall and river gauges, the situation report --
# and the human gate, audit and redaction hooks fire on that tool-call path.
# With a completion-only model the same tools are called from Python around it.
# /healthz reports which of the two you are actually running.
MODEL_PROVIDER=anthropic

# Bedrock: the deployment path (Nova has no country gate; Anthropic models on
# Bedrock do). Tool-calling: yes.
AWS_REGION=us-east-1
BEDROCK_MODEL_HEAVY=us.amazon.nova-pro-v1:0
BEDROCK_MODEL_LIGHT=us.amazon.nova-lite-v1:0

# Direct Anthropic API: the quickest way to a working tool-calling demo.
# Tool-calling: yes. Never commit a key -- .env is gitignored, this file is not.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_HEAVY=claude-opus-4-5
ANTHROPIC_MODEL_LIGHT=claude-haiku-4-5-20251001

# Ollama: the offline fallback. Note the port: the desktop app's own server may
# be misconfigured, so this build runs a correctly-configured server on 11435.
# See the README.
OLLAMA_HOST=http://127.0.0.1:11435
OLLAMA_MODEL_HEAVY=phi3:mini
OLLAMA_MODEL_LIGHT=phi3:mini
# Whether the Ollama models named above can actually tool-call. phi3:mini and
# deepseek-r1:7b cannot, so this stays false and the pipeline calls the tools
# itself. Models that can -- qwen2.5, llama3.1, mistral-nemo -- set it true and
# get the same model-driven tool use as the hosted providers.
OLLAMA_TOOL_CALLING=false

# --- Storage ----------------------------------------------------------------
DDB_TABLE=floodrelay
# "memory" (default) for the in-process store, http://localhost:8000 for
# DynamoDB Local, or unset in AWS.
DDB_ENDPOINT=memory
S3_BUCKET=floodrelay-media
S3_ENDPOINT=
MEDIA_DIR=

# --- Outbound services ------------------------------------------------------
# Nominatim REJECTS placeholder contacts: a User-Agent containing "example.org"
# returns HTTP 403. Put a real contact you control here.
NOMINATIM_USER_AGENT=FloodRelay/0.1
NOMINATIM_BASE=https://nominatim.openstreetmap.org
OVERPASS_BASE=https://overpass-api.de/api/interpreter
OPEN_METEO_BASE=https://api.open-meteo.com/v1
RELIEFWEB_BASE=https://api.reliefweb.int/v1

# Bias geocoding to the district being coordinated: west,north,east,south.
# Villages share names across districts; a wrong district is a wrong dispatch.
GEOCODE_VIEWBOX=71.65,34.15,72.30,33.85

# --- Telemetry --------------------------------------------------------------
# Unset disables tracing entirely. Jaeger locally, CloudWatch in AWS.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=floodrelay-agent

# --- Behaviour --------------------------------------------------------------
DEMO_MODE=true
CORS_ORIGINS=http://localhost:3000

# Shared secret for POST /internal/rescan, which the scheduler calls. Unset
# means the route is unauthenticated -- fine locally, not fine when deployed.
INTERNAL_TOKEN=

# App secret for POST /intake/webhook. This one fails CLOSED: with no value the
# route refuses every request, signed or not. It is a public URL anyone can post
# to, and an unauthenticated one is a queue anyone can fill. Set it to the app
# secret of the WhatsApp Business account, which signs the raw body as
# X-Hub-Signature-256: sha256=<hex>.
WEBHOOK_SECRET=

# Gate thresholds, named here so the rules are auditable in one place.
GEO_CONFIDENCE_FLOOR=0.55
DEDUPE_AUTO_THRESHOLD=0.75
DEDUPE_ASK_FLOOR=0.40
DEDUPE_RADIUS_M=1500
DEDUPE_WINDOW_HOURS=6
